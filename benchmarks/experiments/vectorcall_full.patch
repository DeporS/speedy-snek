+    /// PROTOTYPE ONLY: turn on vectorcall for `NativeWrapper` by writing
+    /// `tp_vectorcall_offset` and `Py_TPFLAGS_HAVE_VECTORCALL` into the
+    /// type PyO3 created. PyO3 0.29 has no supported way to do this.
+    fn enable_vectorcall(py: Python<'_>) -> PyResult<()> {
+        let probe = Bound::new(py, NativeWrapper::new(py.None(), py.None(), py.None(), None))?;
+        let offset = (&probe.get().vectorcall as *const _ as isize) - (probe.as_ptr() as isize);
+        let ty = py.get_type::<NativeWrapper>();
+        // SAFETY: prototype; see above.
+        unsafe {
+            let tp = ty.as_type_ptr();
+            (*tp).tp_vectorcall_offset = offset;
+            (*tp).tp_flags |= ffi::Py_TPFLAGS_HAVE_VECTORCALL;
+            ffi::PyType_Modified(tp);
+        }
+        Ok(())
+    }
