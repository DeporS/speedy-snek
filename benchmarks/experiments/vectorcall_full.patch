+    /// PROTOTYPE: one call's arguments, from `tp_call` or vectorcall.
+    trait CallArgs<'py> {
+        fn positional(&self) -> usize;
+        fn keywords(&self) -> bool;
+        fn exact_i64s(&self) -> bool;
+        fn try_native(&self, function: &I64Function) -> PyResult<Option<i64>>;
+        fn call(&self, func: &Bound<'py, PyAny>) -> PyResult<Bound<'py, PyAny>>;
+        fn tuple(&self) -> PyResult<Bound<'py, PyTuple>>;
+    }
+
+    struct TupleArgs<'a, 'py> {
+        args: &'a Bound<'py, PyTuple>,
+        kwargs: Option<&'a Bound<'py, PyDict>>,
+    }
+
+    impl<'py> CallArgs<'py> for TupleArgs<'_, 'py> {
+        #[inline(always)]
+        fn positional(&self) -> usize {
+            self.args.len()
+        }
+        #[inline(always)]
+        fn keywords(&self) -> bool {
+            self.kwargs.is_some_and(|kwargs| !kwargs.is_empty())
+        }
+        fn exact_i64s(&self) -> bool {
+            exact_i64s(self.args)
+        }
+        #[inline(always)]
+        fn try_native(&self, function: &I64Function) -> PyResult<Option<i64>> {
+            function.try_call_tuple(self.args)
+        }
+        fn call(&self, func: &Bound<'py, PyAny>) -> PyResult<Bound<'py, PyAny>> {
+            func.call(self.args, self.kwargs)
+        }
+        fn tuple(&self) -> PyResult<Bound<'py, PyTuple>> {
+            Ok(self.args.clone())
+        }
+    }
